# ─────────────────────────────────────────────────────────────────────────────
# Packowell — environment template
#
# Copy to `.env` for local development:  cp .env.example .env
# Never commit the real `.env`; it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Server-side only. Gates /enquiries (customer lead inbox) and /admin/jobs
# (production board), and signs the enquiry session cookie.
# Use a long random string in production — this is the ONLY thing protecting
# customer contact details and uploaded artwork.
# Generate one with:  openssl rand -base64 32
ADMIN_PASSCODE=

# Prisma datasource. Read by BOTH prisma.config.ts and src/lib/db.ts.
# Local default when unset: file:./dev.db
#
# Local development:
#   DATABASE_URL="file:./prisma/dev.db"
#
# Container host with a persistent volume mounted at /app/prisma:
#   DATABASE_URL="file:./prisma/dev.db"
#
# Remote libSQL / Turso (works from serverless; see docs/DEPLOYMENT.md):
#   DATABASE_URL="libsql://<db>-<org>.turso.io"
#   LIBSQL_AUTH_TOKEN=<token>
#
# NOTE: the schema provider is "sqlite". A libsql:// URL works because the
# project uses @prisma/adapter-libsql. A plain postgresql:// URL does NOT
# work without changing the schema provider and re-migrating.
DATABASE_URL=

# ── Optional / host-specific ─────────────────────────────────────────────────

# Port for the Bun API server (server.tsx). Most PaaS hosts inject this.
# Local default: 3101. Container hosts usually want 8080.
PORT=

# Public origin of the SPA, used for absolute URLs (OG tags, share cards).
SITE_URL=https://packowell.com

# Where the SPA should send API calls. Leave EMPTY when the API and the static
# site share an origin (the recommended single-container deploy) — the app
# uses relative /api/* paths and works with no configuration.
# Only set this if you split frontend and backend across different hosts.
API_URL=
